{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "M-OS",
  "version": "0.2.2",
  "identifier": "com.codedbym.mos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "M/OS",
        "width": 1180,
        "height": 760,
        "minWidth": 840,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "quick-capture",
        "title": "M/OS Quick Capture",
        "width": 640,
        "height": 126,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBN0I5RkMyN0MwRDg3NTcKUldSWGh3MTh3cDk3T3FYcTN4c2p6a3ViOXQ4WnArSjB0MHVjNDU4YWNyUC9rU041Tk1ESmhIQ3IK",
      "endpoints": [
        "https://github.com/theusinshow/m-os/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
