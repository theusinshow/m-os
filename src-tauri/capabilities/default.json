{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissoes minimas do CronoCAD. Acesso a dados acontece por comandos especificos no backend; nenhum SQL arbitrario e exposto ao frontend (secao 19).",
  "windows": ["main", "reminder"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "core:window:allow-unminimize",
    "notification:default",
    "dialog:default"
  ]
}
